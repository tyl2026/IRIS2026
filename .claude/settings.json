  "statusLine": {
    "type": "command",
    "command": "bash -c 'input=$(cat); m=$(echo \"$input\"|jq -r \".model.display_name//empty\"); in=$(echo \"$input\"|jq -r \".context_window.current_usage.input_tokens//.context_window.total_input_tokens//0\"); out=$(echo \"$input\"|jq -r \".context_window.current_usage.output_tokens//.context_window.total_output_tokens//0\"); ctx=$(echo \"$input\"|jq -r \".context_window.used_percentage//empty\"); f5=$(echo \"$input\"|jq -r \".rate_limits.five_hour.used_percentage//empty\"); fmt(){ local n=$1; if [ \"$n\" -ge 1000000 ] 2>/dev/null; then awk -vn=\"$n\" \"BEGIN{printf \\\"%.1fM\\\",n/1000000}\"; elif [ \"$n\" -ge 1000 ] 2>/dev/null; then awk -vn=\"$n\" \"BEGIN{printf \\\"%.1fk\\\",n/1000}\"; else echo \"$n\"; fi; }; inf=$(fmt \"$in\"); outf=$(fmt \"$out\"); cost=\"\"; if [ \"$in\" -gt 0 ] 2>/dev/null; then ci=$(awk -vn=\"$in\" \"BEGIN{printf \\\"%.4f\\\",(n/1000000)*0.28}\"); co=$(awk -vn=\"$out\" \"BEGIN{printf \\\"%.4f\\\",(n/1000000)*1.68}\"); ct=$(awk -vci=\"$ci\" -vco=\"$co\" \"BEGIN{printf \\\"%.4f\\\",ci+co}\"); [ -n \"$ct\" ] && [ \"$ct\" != \"0.0000\" ] && [ \"$ct\" != \"0\" ] && cost=$(printf \" | \\044%.4f\" \"$ct\"); fi; s=\"\"; [ -n \"$m\" ] && s=\"$m\"; [ -n \"$inf\" ] && s=\"$s | In:${inf} Out:${outf}\"; [ -n \"$ctx\" ] && s=\"$s | $(printf \"%.0f\" \"$ctx\")%% ctx\"; [ -n \"$cost\" ] && s=\"$s$cost\"; [ -n \"$f5\" ] && s=\"$s | 5h:$(printf \"%.0f\" \"$f5\")%%\"; [ -z \"$s\" ] && s=\"-- waiting for API --\"; echo \"$s\"'"
  },
