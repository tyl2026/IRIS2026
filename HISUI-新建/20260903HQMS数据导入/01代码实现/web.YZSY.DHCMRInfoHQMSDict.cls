/// 检查某字符串是否为合法 UTF-8（用于上传文件编码识别）
/// 返回 1=合法UTF-8 0=非UTF-8(按GB18030处理)
ClassMethod IsUTF8(data As %String) As %Boolean
{
	; 注：循环体内不允许 QUIT 带参数，用 bad 标志收敛后统一返回
	s len = $l(data)
	s i = 1
	s bad = 0
	while (i <= len) && (bad = 0) {
		s b = $a(data, i)
		if b < 128 { s i = i + 1 continue }
		if (b >= 194) && (b <= 223) { s n = 1 }
		elseif (b >= 224) && (b <= 239) { s n = 2 }
		elseif (b >= 240) && (b <= 244) { s n = 3 }
		else { s bad = 1 continue }
		if bad = 0 {
			if (i + n) > len { s bad = 1 continue }
			for j = 1:1:n {
				s cb = $a(data, i + j)
				if (cb < 128) || (cb > 191) { s bad = 1 }
			}
			if bad = 0 { s i = i + n + 1 }
		}
	}
	q $s(bad = 1:0, 1:1)
}

