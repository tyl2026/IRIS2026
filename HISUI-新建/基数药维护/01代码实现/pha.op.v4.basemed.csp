<!DOCTYPE html>
<!--基数药维护
	csp: csp/pha.op.v4.basemed.csp
	js:  scripts/pha/op/v4/basemed.js
-->
<html>
<!-- 验证session过期 -->
<csp:method name=OnPreHTTP arguments="" returntype=%Boolean>
    d ##Class(websys.SessionEvents).SessionExpired() q 1
</csp:method>

<head>
    <!-- iMedical版本标题 -->
    <title>
        <TRAK:TRANSLATE id=title>##(%session.Get("TITLE"))##</TRAK:TRANSLATE>
    </title>
    <TRAK:HEAD>
    </TRAK:HEAD>
    <HISUI />
    <PHALIBV1 />
</head>

<body>
    <div class="hisui-layout" fit="true">
        <div data-options="region:'center',border:false" id="lyCenter">
            <table id="gridBaseMed"></table>
        </div>
    </div>
    <!-- 表格工具栏 -->
    <div id="gridBaseMedGridBar">
        <div class="pha-row">
            <div class="pha-col">
                <label id="_HospListLabel">#(..Get("医院"))#</label>
            </div>
            <div class="pha-col">
                <input id="_HospList">
            </div>
             <div class="pha-col">
                <label>#(..Get("类型"))#</label>
            </div>
            <div class="pha-col">
                <input id="conBaseType">
            </div>
            <div class="pha-col">
            	<a class="hisui-linkbutton" plain='false' iconCls="icon-w-find" id="btnFind">查询</a>
            </div>
        </div>
        <div class="pha-line"></div>
        <div>
            <a class="hisui-linkbutton" plain='true' iconCls="icon-add" id="btnAdd">新增</a>
            <a class="hisui-linkbutton" plain='true' iconCls="icon-save" id="btnSave">保存</a>
            <a class="hisui-linkbutton" plain='true' iconCls="icon-cancel" id="btnDelete">删除</a>
            <a class="hisui-linkbutton" plain='true' iconCls="icon-w-export" id="btnExport">导出</a>
            <input class="hisui-filebox" id="impBaseMedFile" data-options="width:230,buttonAlign:'left',buttonText:'选择导入文件',plain:true,prompt:'*.xls,*.xlsx,*.csv'" accept=".xls,.xlsx,.csv,text/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            <a class="hisui-linkbutton" plain='true' iconCls="icon-w-import" id="btnImport">导入</a>
            <a class="hisui-linkbutton" plain='true' iconCls="icon-help" id="btnHelp">帮助</a>
        </div>
    </div>
    <!-- 本页面js -->
    <script type="text/javascript" src="../scripts/hisui/websys.comm.js"></script>
    <script type="text/javascript" src="../scripts/pha/op/v4/common.js"></script>
    <script type="text/javascript" src="../scripts/pha/op/v4/store.js"></script>
    <script type="text/javascript" src="../scripts/xlsx.full.min.js"></script>
    <script type="text/javascript" src="../scripts/pha/op/v4/basemed.js"></script>
</body>

</html>
