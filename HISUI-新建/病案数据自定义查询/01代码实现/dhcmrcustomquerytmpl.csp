<csp:content type="text/html" charset="utf-8">
<csp:method name="OnPreHTTP" arguments="" returntype="%Boolean">
    s %response.CharSet = "utf-8"
    q 1
</csp:method>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>模板配置管理</title>
<EXTHEALTH:HEAD></EXTHEALTH:HEAD>
<HISUI/>
<style>
body{background:#cee4ff;font-family:"Microsoft Yahei";font-size:14px;margin:0;padding:0}
.scope-tag{padding:1px 8px;border-radius:10px;font-size:10px}
.scope-tag.public{background:#e6f7e6;color:#389e0d}
.scope-tag.private{background:#fff7e6;color:#d46b08}
</style>
</head>
<body>
<div id="mainLayout" class="hisui-layout" data-options="fit:true">
    <div data-options="region:'north',border:false" style="height:50px;padding:8px 14px;background:#F9FBFF;border-bottom:2px solid #95B8E7;display:flex;align-items:center;gap:10px">
        <span style="font-weight:700;font-size:14px">模板配置管理</span>
        <select id="filterActive" class="hisui-combobox" style="width:100px">
            <option value="">全部</option>
            <option value="1">启用</option>
            <option value="0">禁用</option>
        </select>
        <a class="hisui-linkbutton" onclick="loadData()" data-options="iconCls:'icon-search'">查询</a>
    </div>
    <div data-options="region:'center',border:false" style="overflow:hidden">
        <table id="dgTemplates" class="hisui-datagrid"></table>
    </div>
</div>

<!-- 编辑弹窗 -->
<div id="dlgEdit" class="hisui-dialog" data-options="closed:true,title:'编辑模板',width:500,height:400,modal:true">
    <div style="padding:12px">
        <div style="margin-bottom:10px"><label>模板名称</label><input id="editName" class="hisui-textbox" style="width:100%"></div>
        <div style="margin-bottom:10px">
            <label>可见范围</label>
            <select id="editScope" class="hisui-combobox" style="width:150px">
                <option value="G">通用（所有人可见）</option>
                <option value="P">个人（仅自己可见）</option>
            </select>
            <label style="margin-left:16px">状态</label>
            <select id="editActive" class="hisui-combobox" style="width:100px">
                <option value="1">启用</option>
                <option value="0">禁用</option>
            </select>
        </div>
        <div style="border-top:1px solid #ddd;padding-top:8px;margin-top:4px">
            <div style="font-weight:600;font-size:12px;margin-bottom:4px">输出列（<span id="editColCount">0</span>列）：</div>
            <div id="editColPreview" style="display:flex;gap:4px;flex-wrap:wrap;font-size:12px;max-height:100px;overflow:auto"></div>
        </div>
        <div style="border-top:1px solid #ddd;padding-top:8px;margin-top:8px">
            <div style="font-weight:600;font-size:12px;margin-bottom:4px">查询条件（<span id="editCondCount">0</span>条）：</div>
            <div id="editCondPreview" style="font-size:12px;color:#555;max-height:80px;overflow:auto"></div>
        </div>
    </div>
    <div style="text-align:right;padding:8px;border-top:1px solid #ddd">
        <a class="hisui-linkbutton" onclick="saveEdit()" data-options="iconCls:'icon-ok'">保存</a>
        <a class="hisui-linkbutton" onclick="$('#dlgEdit').dialog('close')">取消</a>
    </div>
</div>

<script type="text/javascript" src="../scripts/dhcmrcustomquerytmpl.js"></script>
</body>
</html>
</csp:content>
