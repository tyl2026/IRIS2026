/// 初始化/重建 User.YZSYHQMSDataDic（先清空再插入字典项与绑定）
/// 返回 JSON: {"success":1,"items":414,"binds":276}
ClassMethod EnsureSeed() As %String
{
	s cnt = 0
	&sql(select count(*) into :cnt from SQLUser.YZSYHQMSDataDic)
	if cnt > 0 q "{""success"":1,""items"":"_cnt_",""binds"":0,""note"":""已存在，跳过""}"
	&sql(delete from SQLUser.YZSYHQMSDataDic)
	s items = ..GetItems()
	s binds = ..GetBindings()
	s ic = 0
	for i = 1:1:$l(items, $c(1)) {
		s item = $p(items, $c(1), i)
		s d = ##class(User.YZSYHQMSDataDic).%New()
		s d.FldCode = "*"
		s d.DicNo = $p(item, "^", 1)
		s d.ItemValue = $p(item, "^", 2)
		s d.ItemDesc = $p(item, "^", 3)
		d d.%Save()
		s ic = ic + 1
	}
	s bc = 0
	for i = 1:1:$l(binds, $c(1)) {
		s item = $p(binds, $c(1), i)
		s d = ##class(User.YZSYHQMSDataDic).%New()
		s d.FldCode = $p(item, "^", 1)
		s d.DicNo = $p(item, "^", 2)
		s d.ItemValue = ""
		s d.ItemDesc = ""
		d d.%Save()
		s bc = bc + 1
	}
	q "{""success"":1,""items"":"_ic_",""binds"":"_bc_"}"
}

