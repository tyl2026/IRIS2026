ClassMethod GetSemanticDefaults() As %String
{
	s sd = ""
	s sd = sd _ $lb("IDCardNo^身份证号^A20")
	s sd = sd _ $lb("RYRQ^入院日期^B12")
	s sd = sd _ $lb("CYRQ^出院日期^B15")
	s sd = sd _ $lb("MainDiag^主要诊断^C04N")
	s sd = sd _ $lb("MainOper^主要手术^C14x01N")
