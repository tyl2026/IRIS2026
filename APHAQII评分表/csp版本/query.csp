<!--
  Apache II 评分数据查询 — IRIS CSP 页面 (蓝色清新主题)
  ============================================
  部署: 复制到 <IRIS>\CSP\user\query.csp
  访问: http://<IRIS主机>:52773/csp/user/query.csp
  功能: 按日期范围、住院号、患者姓名查询评估记录，AJAX 分页 + xlsx 导出
-->
<csp:content-type type="text/html; charset=UTF-8" />

<!-- ===== 数据 API（JSON / 导出 xlsx） ===== -->
<script language="cache" runat="server" method="OnPreHTTP" returntype="%Boolean">
  Set isJson   = (%request.Get("json") = "1")
  Set isExport = (%request.Get("export_data") = "1")

  If 'isJson, 'isExport { Quit 1 }

  Set %response.ContentType = "application/json; charset=UTF-8"
  Set %response.CharSet = "UTF-8"

  Set prevNS = $namespace
  ZN "DHC-APP"

  Set startDate   = %request.Get("start_date", "")
  Set endDate     = %request.Get("end_date", "")
  Set admissionNo = %request.Get("admission_no", "")
  Set patientName = %request.Get("patient_name", "")

  Set page = +%request.Get("page", "1")
  If page < 1 { Set page = 1 }
  Set pageSize = 20

  // —— 构建 WHERE 子句 ——
  Set whereParts = ""
  If startDate '= "" {
    Set whereParts = whereParts _ " AND AssessmentDate >= " _ $zdateh(startDate, 3)
  }
  If endDate '= "" {
    Set whereParts = whereParts _ " AND AssessmentDate <= " _ $zdateh(endDate, 3)
  }
  If admissionNo '= "" {
    Set safeAdm = $replace(admissionNo, "'", "''")
    Set whereParts = whereParts _ " AND AdmissionNo LIKE '%" _ safeAdm _ "%'"
  }
  If patientName '= "" {
    Set safeName = $replace(patientName, "'", "''")
    Set whereParts = whereParts _ " AND PatientName LIKE '%" _ safeName _ "%'"
  }

  Set whereClause = ""
  If whereParts '= "" { Set whereClause = " WHERE " _ $extract(whereParts, 6, *) }

  // —— COUNT 查询 ——
  Set countSql = "SELECT COUNT(*) FROM ApacheII_Model.Assessment" _ whereClause
  Set countRs = ##class(%SQL.Statement).%ExecDirect(, countSql)
  Set totalCount = 0
  If countRs.%SQLCODE >= 0, countRs.%Next() { Set totalCount = countRs.%GetData(1) }

  Set totalPages = totalCount \ pageSize
  If totalCount # pageSize > 0 { Set totalPages = totalPages + 1 }
  If totalPages < 1 { Set totalPages = 1 }
  If page > totalPages { Set page = totalPages }

  // —— 列定义 ——
  Set baseCols = "AssessmentDate,PatientName,AdmissionNo,BedNo,"
               _ "Temperature,TempScore,MAP,MAPScore,HeartRate,HRScore,"
               _ "RespiratoryRate,RRScore,FiO2Mode,PaO2,AaDO2,OxyScore,"
               _ "ArterialpH,pHScore,SerumSodium,SodiumScore,SerumPotassium,"
               _ "PotassiumScore,SerumCreatinine,CreatinineScore,AcuteRenalFailure,"
               _ "Hematocrit,HCTScore,WBC,WBCScore,GCS,GCSScore,"
               _ "AgeGroup,AgeScore,ChronicHealth,ChronicScore,"
               _ "TotalScore,MortalityEstimate,CreatedAt"

  If isExport {
    // 导出全部筛选数据
    Set sql = "SELECT " _ baseCols _ " FROM ApacheII_Model.Assessment"
            _ whereClause _ " ORDER BY AssessmentDate DESC, ID DESC"
  } Else {
    // 分页查询
    Set offset = page * pageSize
    Set sql = "SELECT TOP " _ pageSize _ " * FROM ("
            _ "SELECT TOP " _ offset _ " " _ baseCols
            _ " FROM ApacheII_Model.Assessment" _ whereClause
            _ " ORDER BY AssessmentDate DESC, ID DESC"
            _ ") ORDER BY AssessmentDate ASC, ID ASC"
  }

  Set rs = ##class(%SQL.Statement).%ExecDirect(, sql)

  If rs.%SQLCODE < 0 {
    Set _v = rs.%Message
    Set _v = $replace($replace($replace($replace($replace(_v, "\", "\\"), """", "\"""), $char(10), "\n"), $char(13), "\r"), $char(9), "\t")
    Write "{""success"":false,""message"":""" _ _v _ """}"
    ZN prevNS
    Quit 0
  }

  // —— 构建 records JSON 字符串 ——
  Set recordsJson = "["
  Set firstRec = 1

  While rs.%Next() {
    If 'firstRec { Set recordsJson = recordsJson _ "," }
    Set firstRec = 0
    Set recordsJson = recordsJson _ "{"

    // -- assessment_date --
    Set _v = $select(rs.%Get("AssessmentDate")="":"", 1:$zdate(rs.%Get("AssessmentDate"), 3))
    Set _v = $select(_v="":"", 1:$replace($replace($replace($replace($replace(_v, "\", "\\"), """", "\"""), $char(10), "\n"), $char(13), "\r"), $char(9), "\t"))
    Set recordsJson = recordsJson _ """assessment_date"":""" _ _v _ """"

    // -- 患者信息 (string fields) --
    Set _v = rs.%Get("PatientName")
    Set _v = $select(_v="":"", 1:$replace($replace($replace($replace($replace(_v, "\", "\\"), """", "\"""), $char(10), "\n"), $char(13), "\r"), $char(9), "\t"))
    Set recordsJson = recordsJson _ ",""patient_name"":""" _ _v _ """"

    Set _v = rs.%Get("AdmissionNo")
    Set _v = $select(_v="":"", 1:$replace($replace($replace($replace($replace(_v, "\", "\\"), """", "\"""), $char(10), "\n"), $char(13), "\r"), $char(9), "\t"))
    Set recordsJson = recordsJson _ ",""admission_no"":""" _ _v _ """"

    Set _v = rs.%Get("BedNo")
    Set _v = $select(_v="":"", 1:$replace($replace($replace($replace($replace(_v, "\", "\\"), """", "\"""), $char(10), "\n"), $char(13), "\r"), $char(9), "\t"))
    Set recordsJson = recordsJson _ ",""bed_no"":""" _ _v _ """"

    // -- 生理指标 (numeric) --
    Set _v = rs.%Get("Temperature")
    Set recordsJson = recordsJson _ ",""temperature"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("TempScore")
    Set recordsJson = recordsJson _ ",""temp_score"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("MAP")
    Set recordsJson = recordsJson _ ",""map"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("MAPScore")
    Set recordsJson = recordsJson _ ",""map_score"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("HeartRate")
    Set recordsJson = recordsJson _ ",""heart_rate"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("HRScore")
    Set recordsJson = recordsJson _ ",""hr_score"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("RespiratoryRate")
    Set recordsJson = recordsJson _ ",""respiratory_rate"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("RRScore")
    Set recordsJson = recordsJson _ ",""rr_score"":" _ $select(_v="":"null", 1:_v)

    // -- 氧合 --
    Set _v = rs.%Get("FiO2Mode")
    If _v = "low"  { Set _v = "FiO2 < 0.5" }
    ElseIf _v = "high" { Set _v = "FiO2 >= 0.5" }
    Set _v = $select(_v="":"", 1:$replace($replace($replace($replace($replace(_v, "\", "\\"), """", "\"""), $char(10), "\n"), $char(13), "\r"), $char(9), "\t"))
    Set recordsJson = recordsJson _ ",""fio2_mode"":""" _ _v _ """"

    Set _v = rs.%Get("PaO2")
    Set recordsJson = recordsJson _ ",""pao2"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("AaDO2")
    Set recordsJson = recordsJson _ ",""aado2"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("OxyScore")
    Set recordsJson = recordsJson _ ",""oxy_score"":" _ $select(_v="":"null", 1:_v)

    // -- 动脉血 pH --
    Set _v = rs.%Get("ArterialpH")
    Set recordsJson = recordsJson _ ",""arterial_ph"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("pHScore")
    Set recordsJson = recordsJson _ ",""ph_score"":" _ $select(_v="":"null", 1:_v)

    // -- 血清 --
    Set _v = rs.%Get("SerumSodium")
    Set recordsJson = recordsJson _ ",""serum_sodium"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("SodiumScore")
    Set recordsJson = recordsJson _ ",""sodium_score"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("SerumPotassium")
    Set recordsJson = recordsJson _ ",""serum_potassium"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("PotassiumScore")
    Set recordsJson = recordsJson _ ",""potassium_score"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("SerumCreatinine")
    Set recordsJson = recordsJson _ ",""serum_creatinine"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("CreatinineScore")
    Set recordsJson = recordsJson _ ",""creatinine_score"":" _ $select(_v="":"null", 1:_v)

    // -- 急性肾衰竭 (string) --
    Set _v = rs.%Get("AcuteRenalFailure")
    If _v = "Y" { Set _v = "是" } ElseIf _v = "N" { Set _v = "否" }
    Set _v = $select(_v="":"", 1:$replace($replace($replace($replace($replace(_v, "\", "\\"), """", "\"""), $char(10), "\n"), $char(13), "\r"), $char(9), "\t"))
    Set recordsJson = recordsJson _ ",""acute_renal_failure"":""" _ _v _ """"

    // -- 血液 (numeric) --
    Set _v = rs.%Get("Hematocrit")
    Set recordsJson = recordsJson _ ",""hematocrit"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("HCTScore")
    Set recordsJson = recordsJson _ ",""hct_score"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("WBC")
    Set recordsJson = recordsJson _ ",""wbc"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("WBCScore")
    Set recordsJson = recordsJson _ ",""wbc_score"":" _ $select(_v="":"null", 1:_v)

    // -- GCS (numeric) --
    Set _v = rs.%Get("GCS")
    Set recordsJson = recordsJson _ ",""gcs"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("GCSScore")
    Set recordsJson = recordsJson _ ",""gcs_score"":" _ $select(_v="":"null", 1:_v)

    // -- 年龄 & 慢性健康 --
    Set _v = rs.%Get("AgeGroup")
    Set _v = $select(_v="":"", 1:$replace($replace($replace($replace($replace(_v, "\", "\\"), """", "\"""), $char(10), "\n"), $char(13), "\r"), $char(9), "\t"))
    Set recordsJson = recordsJson _ ",""age_group"":""" _ _v _ """"

    Set _v = rs.%Get("AgeScore")
    Set recordsJson = recordsJson _ ",""age_score"":" _ $select(_v="":"null", 1:_v)

    Set _v = rs.%Get("ChronicHealth")
    Set _v = $select(_v="":"", 1:$replace($replace($replace($replace($replace(_v, "\", "\\"), """", "\"""), $char(10), "\n"), $char(13), "\r"), $char(9), "\t"))
    Set recordsJson = recordsJson _ ",""chronic_health"":""" _ _v _ """"

    Set _v = rs.%Get("ChronicScore")
    Set recordsJson = recordsJson _ ",""chronic_score"":" _ $select(_v="":"null", 1:_v)

    // -- 汇总 (numeric) --
    Set _v = rs.%Get("TotalScore")
    Set recordsJson = recordsJson _ ",""total_score"":" _ $select(_v="":"null", 1:_v)
    Set _v = rs.%Get("MortalityEstimate")
    Set recordsJson = recordsJson _ ",""mortality_estimate"":" _ $select(_v="":"null", 1:_v)

    // -- 创建时间 (string) --
    Set _v = rs.%Get("CreatedAt")
    Set _v = $select(_v="":"", 1:$extract(_v, 1, 19))
    Set _v = $select(_v="":"", 1:$replace($replace($replace($replace($replace(_v, "\", "\\"), """", "\"""), $char(10), "\n"), $char(13), "\r"), $char(9), "\t"))
    Set recordsJson = recordsJson _ ",""created_at"":""" _ _v _ """"

    Set recordsJson = recordsJson _ "}"
  }

  Set recordsJson = recordsJson _ "]"

  // —— 输出完整 JSON ——
  If isExport {
    Write "{""success"":true,""count"":" _ totalCount _ ",""records"":" _ recordsJson _ "}"
  } Else {
    Write "{""success"":true,""totalCount"":" _ totalCount _ ",""page"":" _ page _ ",""pageSize"":" _ pageSize _ ",""totalPages"":" _ totalPages _ ",""records"":" _ recordsJson _ "}"
  }

  ZN prevNS
  Quit 0
</script>

<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Apache II 评分数据查询</title>
<style>
  :root {
    --blue:           #017bce;
    --blue-dark:      #015a9e;
    --blue-light:     #E3F0FD;
    --blue-bg:        #F5F8FB;

    --white:          #FFFFFF;
    --gray-50:        #F9FAFB;
    --gray-100:       #F0F2F5;
    --gray-200:       #E2E6EA;
    --gray-300:       #CDD3DA;
    --gray-500:       #8B95A1;
    --gray-700:       #4A5568;
    --gray-900:       #1A202C;

    --danger:         #E53E3E;
    --success:        #38A169;
    --warning:        #D69E2E;

    --radius:         6px;
    --shadow-sm:      0 1px 2px rgba(0,0,0,0.04);
    --shadow-md:      0 2px 8px rgba(0,0,0,0.06);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    font-size: 14px;
    background: var(--blue-bg);
    color: var(--gray-900);
    line-height: 1.6;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }

  .container { max-width: 100%; margin: 0 auto; padding: 20px 16px 40px; }

  /* Header */
  .top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-bottom: 3px solid var(--blue);
    padding: 14px 20px;
    border-radius: var(--radius) var(--radius) 0 0;
    flex-wrap: wrap;
    gap: 10px;
  }

  .top-bar h1 {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--blue-dark);
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .top-bar .nav-link {
    font-size: 0.82rem;
    color: var(--blue);
    text-decoration: none;
    font-weight: 500;
  }
  .top-bar .nav-link:hover { color: var(--blue-dark); text-decoration: underline; }

  /* Content Wrap */
  .content-wrap {
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-top: none;
    border-radius: 0 0 var(--radius) var(--radius);
    box-shadow: var(--shadow-md);
    padding: 16px 20px 20px;
  }

  /* Section */
  .section { margin-bottom: 20px; }
  .section:last-child { margin-bottom: 0; }
  .section-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--blue-dark);
    background: var(--blue-light);
    padding: 8px 14px;
    border-radius: 4px;
    border-left: 3px solid var(--blue);
    margin-bottom: 10px;
  }

  /* Filter Form */
  .filter-form {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: flex-end;
  }

  .filter-field {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .filter-field label {
    font-size: 0.7rem;
    color: var(--gray-500);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .filter-field input {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 0.85rem;
    color: var(--gray-900);
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .filter-field input:focus {
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(1,123,206,0.1);
  }
  .filter-field input[type="date"] { width: 145px; }
  .filter-field input[type="text"] { width: 145px; }

  .filter-actions {
    display: flex;
    gap: 8px;
  }

  .btn {
    border: none;
    padding: 7px 20px;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .btn-primary {
    background: var(--blue);
    color: var(--white);
  }
  .btn-primary:hover { background: var(--blue-dark); }
  .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }

  .btn-outline {
    background: transparent;
    border: 1px solid var(--gray-300);
    color: var(--gray-700);
  }
  .btn-outline:hover { background: var(--gray-50); border-color: var(--gray-500); }

  .btn-export {
    background: transparent;
    border: 1px solid var(--blue);
    color: var(--blue);
  }
  .btn-export:hover { background: var(--blue-light); }
  .btn-export:disabled { opacity: 0.6; cursor: not-allowed; }

  /* Table */
  .result-info {
    font-size: 0.78rem;
    color: var(--gray-500);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .result-info strong { color: var(--blue); }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--gray-200);
    border-radius: var(--radius);
    max-height: 70vh;
    overflow-y: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.76rem;
    white-space: nowrap;
  }

  thead th {
    background: var(--blue-light);
    color: var(--blue-dark);
    font-weight: 600;
    padding: 8px 10px;
    text-align: center;
    border-bottom: 2px solid var(--blue);
    position: sticky;
    top: 0;
    z-index: 2;
  }

  tbody td {
    padding: 5px 10px;
    text-align: center;
    border-bottom: 1px solid var(--gray-100);
    color: var(--gray-700);
  }

  tbody tr:nth-child(even) td { background: var(--gray-50); }
  tbody tr:hover td { background: var(--blue-light); }

  .cell-null { color: var(--gray-300); }
  .cell-score { font-weight: 600; color: var(--blue); }
  .cell-total { font-weight: 700; color: var(--blue-dark); font-size: 0.85rem; }
  .cell-mortality { font-weight: 600; }

  .no-data {
    text-align: center;
    padding: 48px 20px;
    color: var(--gray-500);
    font-size: 0.9rem;
  }

  .loading-indicator {
    text-align: center;
    padding: 48px 20px;
    color: var(--gray-500);
    font-size: 0.85rem;
  }

  .error-msg {
    background: #FFF5F5;
    border: 1px solid #FED7D7;
    border-radius: var(--radius);
    padding: 12px 16px;
    color: var(--danger);
    font-size: 0.82rem;
    margin-top: 10px;
  }

  .footer {
    margin-top: 20px; padding-top: 10px;
    border-top: 1px solid var(--gray-200);
    font-size: 0.72rem; color: var(--gray-500);
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 4px;
  }

  /* Pagination */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4px;
    margin-top: 16px;
    flex-wrap: wrap;
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    padding: 0 8px;
    border: 1px solid var(--gray-200);
    border-radius: 4px;
    background: var(--white);
    color: var(--blue);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
    user-select: none;
  }

  .page-btn:hover {
    background: var(--blue-light);
    border-color: var(--blue);
  }

  .page-btn.active {
    background: var(--blue);
    color: var(--white);
    border-color: var(--blue);
    font-weight: 600;
    cursor: default;
  }

  .page-btn.disabled {
    color: var(--gray-300);
    border-color: var(--gray-100);
    cursor: not-allowed;
    pointer-events: none;
  }

  .page-jump {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: 12px;
    font-size: 0.8rem;
    color: var(--gray-500);
  }

  .page-jump input {
    width: 48px;
    height: 32px;
    border: 1px solid var(--gray-200);
    border-radius: 4px;
    text-align: center;
    font-size: 0.8rem;
    font-family: inherit;
    color: var(--gray-900);
    outline: none;
  }
  .page-jump input:focus { border-color: var(--blue); }

  .page-jump .btn-go {
    height: 32px;
    padding: 0 10px;
    background: var(--blue);
    color: var(--white);
    border: none;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
  }
  .page-jump .btn-go:hover { background: var(--blue-dark); }

  @media (max-width: 768px) {
    .container { padding: 10px 8px 20px; }
    .top-bar { flex-direction: column; align-items: flex-start; border-radius: var(--radius) var(--radius) 0 0; }
    .filter-form { flex-direction: column; }
    .filter-field input[type="date"],
    .filter-field input[type="text"] { width: 100%; }
    .filter-actions { width: 100%; }
    .filter-actions .btn { flex: 1; text-align: center; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition-duration: 0.01ms !important; }
  }
</style>
</head>
<body>
<div class="container">

  <!-- ===== 顶栏 ===== -->
  <div class="top-bar">
    <h1>Apache II 评分数据查询</h1>
    <a class="nav-link" href="apache2.csp">返回计算器</a>
  </div>

  <!-- ===== 筛选区 ===== -->
  <div class="content-wrap">
    <div class="section">
      <div class="section-title">筛选条件</div>
      <form class="filter-form" id="filterForm" autocomplete="off">
        <div class="filter-field">
          <label>开始日期</label>
          <input type="date" id="startDate">
        </div>
        <div class="filter-field">
          <label>结束日期</label>
          <input type="date" id="endDate">
        </div>
        <div class="filter-field">
          <label>住院号</label>
          <input type="text" id="admissionNo" placeholder="模糊搜索">
        </div>
        <div class="filter-field">
          <label>患者姓名</label>
          <input type="text" id="patientName" placeholder="模糊搜索">
        </div>
        <div class="filter-actions">
          <button type="submit" class="btn btn-primary">查询</button>
          <button type="button" class="btn btn-outline" id="btnReset">重置</button>
          <button type="button" class="btn btn-export" id="btnExport" disabled>导出 Excel (.xlsx)</button>
        </div>
      </form>
    </div>

    <!-- ===== 结果区 ===== -->
    <div class="section">
      <div class="section-title">查询结果</div>

      <div class="result-info" id="resultInfo">
        <span>请输入筛选条件后点击「查询」</span>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>评估日期</th><th>患者姓名</th><th>住院号</th><th>床号</th>
              <th>体温</th><th>体温评分</th><th>MAP</th><th>MAP评分</th>
              <th>心率</th><th>心率评分</th><th>呼吸频率</th><th>呼吸评分</th>
              <th>氧合模式</th><th>PaO₂</th><th>AaDO₂</th><th>氧合评分</th>
              <th>动脉血pH</th><th>pH评分</th><th>血清钠</th><th>血清钠评分</th>
              <th>血清钾</th><th>血清钾评分</th><th>血清肌酐</th><th>肌酐评分</th>
              <th>急性肾衰竭</th><th>红细胞比容</th><th>HCT评分</th><th>WBC</th><th>WBC评分</th>
              <th>GCS</th><th>GCS评分</th><th>年龄分组</th><th>年龄评分</th>
              <th>慢性健康</th><th>慢性评分</th><th>总分</th><th>预估死亡率</th><th>创建时间</th>
            </tr>
          </thead>
          <tbody id="resultBody">
            <tr><td colspan="39" class="no-data" id="noDataMsg">请输入筛选条件后点击「查询」</td></tr>
          </tbody>
        </table>
      </div>

      <div class="pagination" id="pagination"></div>
    </div>
  </div>

  <footer class="footer">
    <span>Apache II — Acute Physiology And Chronic Health Evaluation II</span>
    <span>IRIS 2021 | Knaus et al., 1985</span>
  </footer>
</div>

<!-- jQuery CDN -->
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<!-- SheetJS CDN for xlsx export -->
<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
<script>
$(function() {

  // ============ 状态 ============
  var currentPage   = 1;
  var totalPages    = 1;
  var totalCount    = 0;
  var isLoading     = false;

  // ============ DOM 引用 ============
  var $startDate    = $('#startDate');
  var $endDate      = $('#endDate');
  var $admissionNo  = $('#admissionNo');
  var $patientName  = $('#patientName');
  var $filterForm   = $('#filterForm');
  var $resultInfo   = $('#resultInfo');
  var $resultBody   = $('#resultBody');
  var $pagination   = $('#pagination');
  var $btnExport    = $('#btnExport');
  var $btnQuery     = $filterForm.find('button[type="submit"]');

  // ============ 初始化日期默认值 ============
  var today = new Date();
  $endDate.val(today.toISOString().split('T')[0]);
  today.setDate(today.getDate() - 30);
  $startDate.val(today.toISOString().split('T')[0]);

  // ============ 获取当前筛选参数 ============
  function getFilterParams() {
    return {
      start_date:   $startDate.val() || '',
      end_date:     $endDate.val() || '',
      admission_no: $admissionNo.val().trim() || '',
      patient_name: $patientName.val().trim() || ''
    };
  }

  // ============ AJAX 加载数据 ============
  function loadData(page) {
    if (isLoading) return;
    isLoading = true;

    var params = getFilterParams();
    params.json = 1;
    params.page = page || 1;

    $btnQuery.prop('disabled', true).text('查询中…');
    $resultBody.html('<tr><td colspan="39" class="loading-indicator">正在加载数据…</td></tr>');
    $pagination.empty();
    $btnExport.prop('disabled', true);

    $.ajax({
      url: 'query.csp',
      data: params,
      dataType: 'json',
      cache: false
    })
    .done(function(res) {
      if (!res.success) {
        $resultBody.html('<tr><td colspan="39" class="no-data">' +
          (res.message || '查询失败') + '</td></tr>');
        $resultInfo.html('<span style="color:var(--danger)">查询出错</span>');
        $btnExport.prop('disabled', true);
        return;
      }

      currentPage = res.page;
      totalPages  = res.totalPages;
      totalCount  = res.totalCount;

      updateResultInfo();
      renderTable(res.records);
      renderPagination();
      $btnExport.prop('disabled', totalCount === 0);
    })
    .fail(function(xhr, status, err) {
      $resultBody.html('<tr><td colspan="39" class="no-data" style="color:var(--danger)">' +
        '网络错误：' + (err || status) + '</td></tr>');
      $resultInfo.html('<span style="color:var(--danger)">请求失败 (HTTP ' + xhr.status + ')</span>');
      $btnExport.prop('disabled', true);
    })
    .always(function() {
      isLoading = false;
      $btnQuery.prop('disabled', false).text('查询');
    });
  }

  // ============ 更新结果信息 ============
  function updateResultInfo() {
    var filters = getFilterParams();
    var parts = ['共找到 <strong>' + totalCount + '</strong> 条记录'];
    if (totalCount > 0) {
      parts.push('（第 ' + currentPage + '/' + totalPages + ' 页）');
    }
    if (filters.start_date) parts.push('（评估日期 ≥ ' + filters.start_date + '）');
    if (filters.end_date)   parts.push('（评估日期 ≤ ' + filters.end_date + '）');
    $resultInfo.html(parts.join(' '));
  }

  // ============ 渲染表格 ============
  function renderTable(records) {
    if (!records || records.length === 0) {
      $resultBody.html('<tr><td colspan="39" class="no-data">' +
        '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:block;margin:0 auto 12px;opacity:0.3">' +
        '<circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>' +
        '</svg>暂无匹配的评估记录</td></tr>');
      return;
    }

    var rows = [];
    $.each(records, function(i, r) {
      var tds = [
        td(r.assessment_date),
        td(r.patient_name),
        td(r.admission_no),
        td(r.bed_no),
        tdNum(r.temperature),
        tdScore(r.temp_score),
        tdNum(r.map),
        tdScore(r.map_score),
        tdNum(r.heart_rate),
        tdScore(r.hr_score),
        tdNum(r.respiratory_rate),
        tdScore(r.rr_score),
        td(r.fio2_mode),
        tdNum(r.pao2),
        tdNum(r.aado2),
        tdScore(r.oxy_score),
        tdNum(r.arterial_ph),
        tdScore(r.ph_score),
        tdNum(r.serum_sodium),
        tdScore(r.sodium_score),
        tdNum(r.serum_potassium),
        tdScore(r.potassium_score),
        tdNum(r.serum_creatinine),
        tdScore(r.creatinine_score),
        td(r.acute_renal_failure),
        tdNum(r.hematocrit),
        tdScore(r.hct_score),
        tdNum(r.wbc),
        tdScore(r.wbc_score),
        tdNum(r.gcs),
        tdScore(r.gcs_score),
        td(r.age_group),
        tdScore(r.age_score),
        td(r.chronic_health),
        tdScore(r.chronic_score),
        tdTotal(r.total_score),
        tdMortality(r.mortality_estimate),
        td(r.created_at)
      ];
      rows.push('<tr>' + tds.join('') + '</tr>');
    });

    $resultBody.html(rows.join(''));
  }

  function td(val) {
    if (val == null || val === '') return '<td class="cell-null">-</td>';
    return '<td>' + $('<span>').text(val).html() + '</td>';
  }

  function tdNum(val) {
    if (val == null || val === '') return '<td class="cell-null">-</td>';
    return '<td>' + val + '</td>';
  }

  function tdScore(val) {
    if (val == null || val === '') return '<td class="cell-null">-</td>';
    return '<td class="cell-score">' + val + '</td>';
  }

  function tdTotal(val) {
    if (val == null || val === '') return '<td class="cell-null">-</td>';
    return '<td class="cell-total">' + val + '</td>';
  }

  function tdMortality(val) {
    if (val == null || val === '') return '<td class="cell-null">-</td>';
    return '<td class="cell-mortality">' + val + '%</td>';
  }

  // ============ 渲染分页 ============
  function renderPagination() {
    if (totalPages <= 1) {
      $pagination.empty();
      return;
    }

    var html = [];

    // 上一页
    if (currentPage > 1) {
      html.push('<button class="page-btn" data-page="' + (currentPage - 1) + '">上一页</button>');
    } else {
      html.push('<span class="page-btn disabled">上一页</span>');
    }

    // 页码范围（最多显示 10 个）
    var pageStart = Math.max(1, currentPage - 5);
    var pageEnd   = Math.min(totalPages, pageStart + 9);
    if (pageEnd - pageStart < 9) {
      pageStart = Math.max(1, pageEnd - 9);
    }

    for (var i = pageStart; i <= pageEnd; i++) {
      if (i === currentPage) {
        html.push('<span class="page-btn active">' + i + '</span>');
      } else {
        html.push('<button class="page-btn" data-page="' + i + '">' + i + '</button>');
      }
    }

    // 下一页
    if (currentPage < totalPages) {
      html.push('<button class="page-btn" data-page="' + (currentPage + 1) + '">下一页</button>');
    } else {
      html.push('<span class="page-btn disabled">下一页</span>');
    }

    // 跳转输入
    html.push(
      '<span class="page-jump">' +
      '跳至 <input type="number" id="jumpPage" min="1" max="' + totalPages + '" value="' + currentPage + '">' +
      ' / ' + totalPages + ' 页' +
      ' <button class="btn-go" id="btnJump">GO</button>' +
      '</span>'
    );

    $pagination.html(html.join(''));
  }

  // ============ 导出 xlsx ============
  function doExport() {
    if (totalCount === 0) {
      alert('没有可导出的数据');
      return;
    }

    var $btn = $btnExport;
    $btn.prop('disabled', true).text('正在导出…');

    var params = getFilterParams();
    params.export_data = 1;

    $.ajax({
      url: 'query.csp',
      data: params,
      dataType: 'json',
      cache: false
    })
    .done(function(res) {
      if (!res.success || !res.records || res.records.length === 0) {
        alert('导出失败：没有可导出的数据');
        return;
      }

      // 构建 SheetJS 数据（二维数组）
      var headers = [
        '评估日期','患者姓名','住院号','床号',
        '体温','体温评分','MAP','MAP评分',
        '心率','心率评分','呼吸频率','呼吸评分',
        '氧合模式','PaO₂','AaDO₂','氧合评分',
        '动脉血pH','pH评分','血清钠','血清钠评分',
        '血清钾','血清钾评分','血清肌酐','肌酐评分',
        '急性肾衰竭','红细胞比容','HCT评分','WBC','WBC评分',
        'GCS','GCS评分','年龄分组','年龄评分',
        '慢性健康','慢性评分','总分','预估死亡率','创建时间'
      ];

      var data = [headers];
      $.each(res.records, function(i, r) {
        data.push([
          r.assessment_date   || '',  r.patient_name      || '',  r.admission_no      || '',  r.bed_no            || '',
          r.temperature       || '',  r.temp_score        || '',  r.map               || '',  r.map_score         || '',
          r.heart_rate        || '',  r.hr_score          || '',  r.respiratory_rate  || '',  r.rr_score          || '',
          r.fio2_mode         || '',  r.pao2              || '',  r.aado2             || '',  r.oxy_score         || '',
          r.arterial_ph       || '',  r.ph_score          || '',  r.serum_sodium      || '',  r.sodium_score      || '',
          r.serum_potassium   || '',  r.potassium_score   || '',  r.serum_creatinine  || '',  r.creatinine_score  || '',
          r.acute_renal_failure || '', r.hematocrit       || '',  r.hct_score         || '',  r.wbc               || '',  r.wbc_score || '',
          r.gcs               || '',  r.gcs_score         || '',  r.age_group         || '',  r.age_score         || '',
          r.chronic_health    || '',  r.chronic_score     || '',  r.total_score       || '',  r.mortality_estimate || '',  r.created_at || ''
        ]);
      });

      var wb = XLSX.utils.book_new();
      var ws = XLSX.utils.aoa_to_sheet(data);

      // 设置列宽
      ws['!cols'] = headers.map(function() { return { wch: 14 }; });

      XLSX.utils.book_append_sheet(wb, ws, 'ApacheII评估记录');

      // 生成文件名（含导出日期）
      var exportDate = new Date().toISOString().split('T')[0];
      var filename = 'ApacheII_export_' + exportDate + '.xlsx';

      XLSX.writeFile(wb, filename);
    })
    .fail(function(xhr, status, err) {
      alert('导出请求失败：' + (err || status) + ' (HTTP ' + xhr.status + ')');
    })
    .always(function() {
      $btn.prop('disabled', false).text('导出 Excel (.xlsx)');
    });
  }

  // ============ 事件绑定 ============

  // 表单提交 —— AJAX 查询
  $filterForm.on('submit', function(e) {
    e.preventDefault();

    var start = $startDate.val();
    var end   = $endDate.val();
    if (start && end && start > end) {
      alert('开始日期不能晚于结束日期');
      $startDate.focus();
      return;
    }

    loadData(1);
  });

  // 重置按钮
  $('#btnReset').on('click', function() {
    $startDate.val('');
    $endDate.val('');
    $admissionNo.val('');
    $patientName.val('');

    // 恢复默认日期
    var d = new Date();
    $endDate.val(d.toISOString().split('T')[0]);
    d.setDate(d.getDate() - 30);
    $startDate.val(d.toISOString().split('T')[0]);

    loadData(1);
  });

  // 分页按钮点击（事件委托）
  $pagination.on('click', '.page-btn[data-page]', function() {
    var page = parseInt($(this).data('page'));
    if (!isNaN(page) && page >= 1 && page <= totalPages) {
      loadData(page);
    }
  });

  // 跳转按钮
  $pagination.on('click', '#btnJump', function() {
    var page = parseInt($('#jumpPage').val());
    if (isNaN(page) || page < 1 || page > totalPages) {
      alert('请输入有效的页码（1 - ' + totalPages + '）');
      $('#jumpPage').val(currentPage).focus();
      return;
    }
    loadData(page);
  });

  // 跳转输入框回车
  $pagination.on('keypress', '#jumpPage', function(e) {
    if (e.which === 13) {
      $('#btnJump').trigger('click');
    }
  });

  // 导出按钮
  $btnExport.on('click', doExport);

  // ============ 初始加载 ============
  loadData(1);
});
</script>
</body>
</html>
