$('#HISUIDataTableElement_34').datagrid('getPager').pagination({
onSelectPage:function(pageNumber, pageSize){
var PageStart=(pageNumber-1)*pageSize+1;
var PageEnd=pageNumber*pageSize;
$('#HISUIDataTableElement_34').data('nurPageNumber', pageNumber);
$('#HISUIDataTableElement_34').data('nurPageSize', pageSize);
var queryParam=$('#HISUIDataTableElement_34').attr('queryInfo');
GetDataFromService(null,["HISUIDataTableElement_34"],'PageStart='+PageStart+'&PageEnd='+PageEnd,queryParam);
}
});
function HISUIDataTableElement_34_onDblClickRow(rowIndex, rowData) 
{
OnHisuiEditClickRow(rowIndex, rowData,'HISUIDataTableElement_34')
}

function HISUIDataTableElement_34_onBeginEdit(i,d) 
{
$('.datagrid-row-editting').removeClass('datagrid-row-editting');
$("tr[datagrid-row-index = '"+i+"']").addClass("datagrid-row-editting");
InitAutoSignature();
}

function HISUIDataTableElement_34_onBeforeEdit(i,d) 
{
