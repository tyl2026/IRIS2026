function AfterChange_TextElement_83()
{
var currentvalue = GetValueById('TextElement_83');
var datas=GetDataSource('TextElement_83',Data_TextElement_83,currentvalue,true);
$.each(datas,function(i,dataNew)
{
if(dataNew.Promptly == "False" && WindowCompleted) return;
if(dataNew.IsPrompt == "True")
{
$.messager.confirm($g("提示"), dataNew.PromptMsg, function (r) {
if (r) {
ChangeData(dataNew,currentvalue,'TextElement_83');
}
});
}
else{
ChangeData(dataNew,currentvalue,'TextElement_83');
}
});

}

