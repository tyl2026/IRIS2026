<style>
body{
	overflow:hidden;
	color:#000000;
	padding:0;
}
body *{
	font-size:12px;
}
.ext-strict .x-small-editor .x-form-text{
	height: 19px !important;
}
.modal-body{
	position:relative;
	padding:10px;
	padding-top:20px;
	padding-bottom:0px;
}
.modal-header {
    min-height: 16.428571429px;
    padding: 15px;
    border-bottom: 0px solid #e5e5e5;
}

#ldsystem{
	top:68px;
	left:5px;
	position:absolute;
	width:160px;
	height:20px;
	font-size:14px;
	text-align:center;
	background-color:lightblue;
	border-radius:10px;
	text-decoration: none;
	}
#druginfo{
	top:98px;
	left:5px;
	position:absolute;
	width:160px;
	height:20px;
	font-size:14px;
	text-align:center;
	background-color:lightblue;
	border-radius:10px;
	text-decoration: none;
	}


.x-grid3-row td,.x-grid3-summary-row td {
