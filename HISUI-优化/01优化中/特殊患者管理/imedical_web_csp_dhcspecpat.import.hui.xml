<?xml version="1.0" encoding="UTF-8"?>
<Export generator="IRIS" version="26" zv="IRIS for UNIX (Red Hat Enterprise Linux for x86-64) 2021.1.2 (Build 336_0_21736U)" ts="2026-06-27 17:06:18">
<CSP name="csp/dhcspecpat.import.hui.csp" application="/imedical/web/" default="1"><![CDATA[
<!-- dhcspecpat.import.hui.csp 特殊患者批量导入对话框 -->
<div id="importDialog" class="hisui-dialog" 
     data-options="title:'批量导入患者',closed:true,modal:true,width:900,height:520,
     buttons:[{text:'确认导入',iconCls:'icon-ok',handler:DoImport},
              {text:'取消',iconCls:'icon-cancel',handler:function(){$('#importDialog').dialog('close');}}]">
    <div style="padding:16px">
        <!-- Step 1: Choose file -->
        <div style="margin-bottom:12px">
            <input type="file" id="importFileInput" accept=".xlsx,.xls" 
                   style="display:none" onchange="HandleFileSelect(event)">
            <a class="hisui-linkbutton" data-options="iconCls:'icon-w-folder'" 
               onclick="document.getElementById('importFileInput').click()">选择 Excel 文件</a>
            <span id="importFileName" style="margin-left:12px;color:#666;font-size:13px">未选择文件</span>
            <a class="hisui-linkbutton" data-options="iconCls:'icon-w-download'" 
               onclick="DownloadTemplate()" style="margin-left:12px">下载模板</a>
        </div>

        <!-- Step 2: Preview table -->
        <div style="margin-bottom:8px;font-weight:bold;color:#15428b;font-size:13px">
            预览数据（前 3 行）
        </div>
        <div style="width:100%;height:210px">
            <div id="importPreviewTable" style="width:100%;height:200px"></div>
        </div>

        <!-- Step 3: Import result -->
        <div id="importResult" style="display:none;margin-top:12px">
            <div style="font-weight:bold;color:#15428b;font-size:13px;margin-bottom:8px">导入结果</div>
            <div id="importResultSummary" style="font-size:13px;margin-bottom:8px"></div>
            <div id="importResultErrors" style="max-height:150px;overflow-y:auto;font-size:12px;color:#d32f2f"></div>
        </div>

        <!-- Hidden: parsed TSV data, set by HandleFileSelect -->
        <input type="hidden" id="importTSVData">
    </div>
</div>
]]></CSP>
</Export>